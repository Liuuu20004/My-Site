---
import type { CollectionEntry } from "astro:content";
import { getProjectUrl } from "@/utils/getPostPaths";
type Props = { project: CollectionEntry<"projects">; noteCount: number };
const { project, noteCount } = Astro.props;
---

<li class="border-border rounded-lg border p-5">
  <h2 class="text-accent text-xl font-semibold">
    <a
      href={getProjectUrl(project.id)}
      class="decoration-dashed underline-offset-4 hover:underline"
      >{project.data.title}</a
    >
  </h2>
  <p class="mt-3">{project.data.description}</p>
  <p class="text-muted-foreground mt-4 text-sm">
    {`${noteCount} ${noteCount === 1 ? "note" : "notes"}`}
  </p>
</li>
